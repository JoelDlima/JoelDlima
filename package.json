{
  "name": "joeldlima-profile",
  "version": "2.0.0",
  "description": "React-authored SVG component system that renders the GitHub profile README.",
  "scripts": {
    "fonts": "node scripts/fetch-fonts.mjs",
    "compile": "esbuild src/cli.ts --bundle --platform=node --format=esm --packages=external --jsx=automatic --outfile=.cache/cli.mjs --log-level=warning",
    "data": "npm run compile && node .cache/cli.mjs data",
    "render": "npm run compile && node .cache/cli.mjs render",
    "build": "npm run compile && node .cache/cli.mjs all",
    "bands": "node scripts/bands.mjs",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoelDlima/JoelDlima.git"
  },
  "type": "module",
  "bugs": {
    "url": "https://github.com/JoelDlima/JoelDlima/issues"
  },
  "homepage": "https://github.com/JoelDlima/JoelDlima#readme",
  "dependencies": {
    "opentype.js": "^2.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.3.0",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "esbuild": "^0.28.2",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2"
  },
  "private": true
}
